# Copy to backend/.env and adjust values for your environment.
# DATABASE_URL=postgresql+asyncpg://docvault:docvault@localhost:5432/docvault
# LOG_LEVEL=INFO
# LOG_JSON=false
# CORS_ORIGINS=["http://localhost:3000"]

# Document indexing and retrieval
CHUNK_MAX_TOKENS=400
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_THREADS=1
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
ANSWER_MAX_SOURCES=8

# Set a strong random value outside local dev
# JWT_SECRET=change-me
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7

# Where the embedding model files live. NOT a tunable cache - it is the model
# store, and fastembed creates one either way (defaulting to a temp directory).
#
# Leave this UNSET unless you know why you are setting it. The container gets
# /opt/models from the Dockerfile, where the model is baked at build time, and a
# real environment variable beats this file - so a value here is ignored there.
# Setting it to a Windows path is actively harmful: it is not absolute on Linux,
# so it resolves inside the bind-mounted source tree and the container cannot
# write to it. On the host, unset means fastembed uses %TEMP%/fastembed_cache.
# FASTEMBED_CACHE_DIR=
